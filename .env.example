# Điền token bot và client id của bạn vào đây
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# Kênh ghi log tập trung của bot (mặc định: 1559750487299850331)
LOG_CHANNEL_ID=1559750487299850331
# Kênh thông báo trạng thái kết nối & reconnect (mặc định: 1547449482835394640)
STATUS_LOG_CHANNEL_ID=1547449482835394640

# Chuỗi kết nối MongoDB Atlas (Tùy chọn, để trống sẽ tự dùng JSON Storage fallback)
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/basori_bot
